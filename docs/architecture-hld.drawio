        </mxCell>
        <mxCell id="svc-user-rbac" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#14532d;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;user-rbac-service&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8081 / gRPC 9091&lt;/b&gt; · JWT Resource Server&lt;br&gt;• Identity &amp;amp; RBAC Data Plane (No JWT minting)&lt;br&gt;• BCrypt (Strength 12) Password Hashing&lt;br&gt;• Dual API: REST &amp;amp; Protobuf gRPC&lt;br&gt;• Internal API Key endpoint for Auth Server&lt;br&gt;&lt;i&gt;2 Replicas · Namespace: banking-core&lt;/i&gt;&lt;/font&gt;" vertex="1">
