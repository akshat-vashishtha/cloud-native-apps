          <mxGeometry x="685" y="140" width="360" height="120" as="geometry" />
        </mxCell>

        <!-- gRPC User-RBAC Channel Node -->
        <mxCell id="node-grpc-rbac" value="&lt;b&gt;gRPC Channel :9091&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;code&gt;GetUserProfile&lt;/code&gt;&lt;br&gt;&lt;code&gt;ValidatePermissions&lt;/code&gt;&lt;br&gt;Deadline: 500ms · TLS mTLS&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontSize=10;verticalAlign=top;spacing=4;shadow=1;" 
