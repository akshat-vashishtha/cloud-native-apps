        <mxCell id="client-browser-auth" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;Browser Login Flow&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OAuth2 Auth Code Redirect&lt;br&gt;SPA never touches JWTs&lt;br&gt;&lt;i&gt;Opaque Cookie APP_SESSION&lt;/i&gt;&lt;/font&gt;" vertex="1">
