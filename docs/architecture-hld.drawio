                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#78350f;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
