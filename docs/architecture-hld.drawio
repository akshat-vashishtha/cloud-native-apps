        <!-- Client Auth Prompt -->
        <mxCell id="client-browser-auth" value="&lt;b&gt;Browser Login Flow&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OAuth2 Auth Code Redirect&lt;br&gt;SPA never touches JWTs&lt;br&gt;&lt;i&gt;Opaque Cookie APP_SESSION&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="65" y="145" width="220" height="95" as="geometry" />
        </mxCell>

        <!-- OAuth2 Authorization Server -->
        <mxCell id="svc-oauth2-as" value="&lt;b&gt;oauth2-authorization-server&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 9000&lt;/b&gt; · Spring Authorization Server&lt;br&gt;• Sole Token Authority (RSA/JWKS)&lt;br&gt;• Hosts Form Login &amp;amp; Consent&lt;br&gt;• Issues JWT: &lt;i&gt;roles, permissions, sub&lt;/i&gt;&lt;br&gt;• Confidential Client: &lt;code&gt;gateway-client&lt;/code&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
