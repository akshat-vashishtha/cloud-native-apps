        <mxCell id="client-web-spa" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;web (Next.js 15 SPA)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• App Router · React 19 · Strict TS&lt;br&gt;• Clean 3-Tier: &lt;i&gt;ui / core / app&lt;/i&gt;&lt;br&gt;• Cookie-only auth (&lt;code&gt;APP_SESSION&lt;/code&gt;)&lt;br&gt;• STOMP WebSocket Client (`/ws`)&lt;br&gt;• Financial Dashboard &amp;amp; AI Chat View&lt;/font&gt;" vertex="1">
          <mxGeometry height="165" width="220" x="-75" y="300" as="geometry" />
        </mxCell>
        <mxCell id="svc-gateway" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;Gateway-Service (BFF)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8080&lt;/b&gt; · Spring Cloud Gateway WebFlux&lt;br&gt;• OAuth2 Client (&lt;code&gt;gateway-client&lt;/code&gt;)&lt;br&gt;• Spring Session Redis (&lt;code&gt;APP_SESSION&lt;/code&gt;)&lt;br&gt;• &lt;b&gt;TokenRelay&lt;/b&gt;: Access Token ➔ Downstream&lt;br&gt;• STOMP WebSocket Reverse Proxy (`/ws/**`)&lt;br&gt;• CORS Filter &amp;amp; Route Dispatcher&lt;br&gt;&lt;i&gt;2–5 Replicas · Namespace: banking-edge&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="175" width="240" x="365" y="290" as="geometry" />
        </mxCell>
        <mxCell id="svc-chat" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#14532d;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;Chat-Communication-Service&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8083&lt;/b&gt; · JWT Resource Server&lt;br&gt;• Real-Time STOMP over WebSocket (`/ws`)&lt;br&gt;• In-Memory SimpleBroker (Artemis Relay Roadmap)&lt;br&gt;• User Queues: &lt;i&gt;/user/{userId}/queue/notifications&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;/user/{userId}/queue/ai-stream&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;/user/{userId}/queue/confirmations (HITL)&lt;/i&gt;&lt;br&gt;• Transactional Outbox (claim via Criteria)&lt;br&gt;&lt;i&gt;2 Replicas · Namespace: banking-core&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="185" width="360" x="685" y="285" as="geometry" />
        </mxCell>
        <mxCell id="node-stomp-broker" parent="layer-components" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff0b3;strokeColor=#d4a017;strokeWidth=1.5;fontColor=#78350f;fontSize=10;verticalAlign=middle;spacing=4;shadow=1;" value="&lt;b&gt;STOMP User Message Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• &lt;code&gt;/topic/public-announcements&lt;/code&gt;&lt;br&gt;• &lt;code&gt;/user/{userId}/queue/notifications&lt;/code&gt; (Txn Push)&lt;br&gt;• &lt;code&gt;/user/{userId}/queue/ai-stream&lt;/code&gt; (Token Stream)&lt;br&gt;• &lt;code&gt;/user/{userId}/queue/confirmations&lt;/code&gt; (HITL Prompt)&lt;br&gt;STOMP Destination ACL Enforcement&lt;/font&gt;" vertex="1">
