        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 2: CLIENT EDGE, GATEWAY BFF & REAL-TIME STOMP CHAT                -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <!-- Web SPA (Next.js 15) -->
        <mxCell id="client-web-spa" value="&lt;b&gt;web (Next.js 15 SPA)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• App Router · React 19 · Strict TS&lt;br&gt;• Clean 3-Tier: &lt;i&gt;ui / core / app&lt;/i&gt;&lt;br&gt;• Cookie-only auth (&lt;code&gt;APP_SESSION&lt;/code&gt;)&lt;br&gt;• STOMP WebSocket Client (`/ws`)&lt;br&gt;• Financial Dashboard &amp;amp; AI Chat View&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="65" y="295" width="220" height="165" as="geometry" />
        </mxCell>

        <!-- Gateway-Service (BFF) -->
        <mxCell id="svc-gateway" value="&lt;b&gt;Gateway-Service (BFF)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8080&lt;/b&gt; · Spring Cloud Gateway WebFlux&lt;br&gt;• OAuth2 Client (&lt;code&gt;gateway-client&lt;/code&gt;)&lt;br&gt;• Spring Session Redis (&lt;code&gt;APP_SESSION&lt;/code&gt;)&lt;br&gt;• &lt;b&gt;TokenRelay&lt;/b&gt;: Access Token ➔ Downstream&lt;br&gt;• STOMP WebSocket Reverse Proxy (`/ws/**`)&lt;br&gt;• CORS Filter &amp;amp; Route Dispatcher&lt;br&gt;&lt;i&gt;2–5 Replicas · Namespace: banking-edge&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="365" y="290" width="240" height="175" as="geometry" />
        </mxCell>

        <!-- Chat-Communication-Service -->
        <mxCell id="svc-chat" value="&lt;b&gt;Chat-Communication-Service&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8083&lt;/b&gt; · JWT Resource Server&lt;br&gt;• Real-Time STOMP over WebSocket (`/ws`)&lt;br&gt;• In-Memory SimpleBroker (Artemis Relay Roadmap)&lt;br&gt;• User Queues: &lt;i&gt;/user/{userId}/queue/notifications&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;/user/{userId}/queue/ai-stream&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;/user/{userId}/queue/confirmations (HITL)&lt;/i&gt;&lt;br&gt;• Transactional Outbox (claim via Criteria)&lt;br&gt;&lt;i&gt;2 Replicas · Namespace: banking-core&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#14532d;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="685" y="285" width="360" height="185" as="geometry" />
        </mxCell>

        <!-- STOMP & Push Message Broker Node -->
        <mxCell id="node-stomp-broker" value="&lt;b&gt;STOMP User Message Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• &lt;code&gt;/topic/public-announcements&lt;/code&gt;&lt;br&gt;• &lt;code&gt;/user/{userId}/queue/notifications&lt;/code&gt; (Txn Push)&lt;br&gt;• &lt;code&gt;/user/{userId}/queue/ai-stream&lt;/code&gt; (Token Stream)&lt;br&gt;• &lt;code&gt;/user/{userId}/queue/confirmations&lt;/code&gt; (HITL Prompt)&lt;br&gt;STOMP Destination ACL Enforcement&lt;/font&gt;" 
                style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff0b3;strokeColor=#d4a017;strokeWidth=1.5;fontColor=#78350f;fontSize=10;verticalAlign=middle;spacing=4;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1130" y="295" width="310" height="120" as="geometry" />
        </mxCell>

        <!-- MongoDB Chat Database -->
        <mxCell id="db-chat-mongo" value="&lt;b&gt;chat_db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MongoDB 7.x&lt;br&gt;Collections:&lt;br&gt;&lt;i&gt;messages, conversations,&lt;br&gt;outbox_events&lt;/i&gt;&lt;br&gt;TTL Index: 30d cleanup&lt;/font&gt;" 
                style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#581c87;fontSize=11;verticalAlign=top;spacing=4;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1530" y="290" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- Redis Chat Presence & Sessions -->
        <mxCell id="cache-chat-presence" value="&lt;b&gt;Redis Presence &amp;amp; Session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;code&gt;chat:presence:sessions:{userId}&lt;/code&gt;&lt;br&gt;Redis Sets (Connection refcount)&lt;br&gt;&lt;code&gt;gateway:session&lt;/code&gt; (Spring Session)&lt;br&gt;TTL: 30m rolling&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#991b1b;fontSize=10;verticalAlign=top;spacing=4;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1750" y="295" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 3: DIGITAL BANKING CORE & TRANSACTIONAL OUTBOX                     -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <!-- Client Financial Operations Action -->
        <mxCell id="client-banking-action" value="&lt;b&gt;Banking Dashboard&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Balance &amp;amp; Ledger Inquiries&lt;br&gt;• Fund Transfers (Peer-to-Peer)&lt;br&gt;• Card Lock / Freeze Controls&lt;br&gt;&lt;i&gt;Idempotency-Key Header attached&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="65" y="525" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Gateway Route Callout: Banking -->
        <mxCell id="gw-route-banking" value="&lt;b&gt;Route: /api/v1/banking/**&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569;&quot;&gt;TokenRelay (Bearer JWT)&lt;br&gt;Path Predicate &amp;amp; CORS Match&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontSize=10;verticalAlign=top;spacing=4;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="375" y="535" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Business-Operation-Service -->
        <mxCell id="svc-business-ops" value="&lt;b&gt;Business-Operation-Service (Banking Core)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8082 / gRPC 9093&lt;/b&gt; · JWT Resource Server&lt;br&gt;• Pure Domain Invariants: &lt;code&gt;Money&lt;/code&gt;, &lt;code&gt;Account&lt;/code&gt;, &lt;code&gt;Transfer&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Transactional Outbox&lt;/b&gt;: Atomic Criteria Claim (`PENDING` ➔ `IN_FLIGHT`)&lt;br&gt;• Optimistic Concurrency Control (@Version retry on balance)&lt;br&gt;• gRPC Server (&lt;code&gt;banking_service.proto&lt;/code&gt;) for AI tool executions&lt;br&gt;&lt;i&gt;3 Replicas · Namespace: banking-core&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#14532d;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="685" y="515" width="360" height="155" as="geometry" />
        </mxCell>

        <!-- Kafka Cluster Topic: banking.transactions.v1 -->
        <mxCell id="kafka-topic-transactions" value="&lt;b&gt;Kafka: banking.transactions.v1&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Partition Key: &lt;code&gt;sourceAccountId&lt;/code&gt; (FIFO per account)&lt;br&gt;• Payload: &lt;i&gt;eventId, sourceUserId, targetUserId, amount, status&lt;/i&gt;&lt;br&gt;• Producers: &lt;b&gt;Business-Ops Outbox Poller&lt;/b&gt;&lt;br&gt;• Consumers: &lt;b&gt;KPI-Analytics&lt;/b&gt; &amp;amp; &lt;b&gt;Chat (Notifications)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Dead Letter Topic: banking.transactions.v1.DLT&lt;/i&gt;&lt;/font&gt;" 
                style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#78350f;fontSize=11;verticalAlign=middle;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1115" y="525" width="340" height="135" as="geometry" />
        </mxCell>

        <!-- MongoDB Banking Database -->
        <mxCell id="db-banking-mongo" value="&lt;b&gt;banking_ops_db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MongoDB 7.x&lt;br&gt;Collections:&lt;br&gt;&lt;i&gt;accounts, transactions,&lt;br&gt;cards, outbox_events&lt;/i&gt;&lt;br&gt;TTL Index: 7d outbox purge&lt;/font&gt;" 
                style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#581c87;fontSize=11;verticalAlign=top;spacing=4;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1530" y="525" width="180" height="115" as="geometry" />
