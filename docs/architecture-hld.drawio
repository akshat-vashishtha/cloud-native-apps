        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 5: REAL-TIME KPI ANALYTICS & FRAUD DETECTION                       -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <!-- Client KPI Metrics Screen -->
        <mxCell id="client-kpi-screen" value="&lt;b&gt;Executive &amp;amp; Audit View&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Real-time Velocity Gauges&lt;br&gt;• Daily Financial Rollups&lt;br&gt;• Fraud Alert Dashboard&lt;br&gt;&lt;i&gt;Requires: kpi:read_analytics&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="65" y="1035" width="220" height="115" as="geometry" />
        </mxCell>

        <!-- Gateway Route Callout: KPI -->
        <mxCell id="gw-route-kpi" value="&lt;b&gt;Route: /api/v1/kpi/**&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569;&quot;&gt;TokenRelay (Bearer JWT)&lt;br&gt;Proxies to KPI Analytics :8084&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontSize=10;verticalAlign=top;spacing=4;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="375" y="1040" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- KPI-Analytics-Service -->
        <mxCell id="svc-kpi-analytics" value="&lt;b&gt;KPI-Analytics-Service (Real-Time Consumer)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8084&lt;/b&gt; · Stateless Analytics Engine&lt;br&gt;• Consumes: &lt;code&gt;banking.transactions.v1&lt;/code&gt;&lt;br&gt;• Idempotent Consumer: Deduplication via Redis &lt;code&gt;event:dedupe:*&lt;/code&gt;&lt;br&gt;• Sliding Window Velocity: Atomic Redis Lua Script (&lt;code&gt;velocity:{accountId}&lt;/code&gt;)&lt;br&gt;• Publishes &lt;b&gt;fraud.alerts.v1&lt;/b&gt; if transfers ≥ 3 in 5m window&lt;br&gt;• Atomic Daily Aggregation: &lt;code&gt;MongoTemplate.upsert&lt;/code&gt; with Criteria&lt;br&gt;&lt;i&gt;KEDA Scaled: 2–8 Replicas · Namespace: banking-analytics&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#14532d;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="685" y="1020" width="360" height="175" as="geometry" />
        </mxCell>

        <!-- Kafka Fraud Stream Topic & DLQ -->
        <mxCell id="kafka-topic-fraud" value="&lt;b&gt;Kafka: fraud.alerts.v1 &amp;amp; DLT&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Partition Key: &lt;code&gt;accountId&lt;/code&gt;&lt;br&gt;• Trigger: Real-time velocity breach threshold&lt;br&gt;• Consumer Error Recovery: &lt;i&gt;DefaultErrorHandler&lt;/i&gt;&lt;br&gt;  + ExponentialBackOff (1s, 2s, 4s, max 3) ➔ DLT&lt;/font&gt;" 
                style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#78350f;fontSize=10;verticalAlign=middle;spacing=6;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1115" y="1035" width="340" height="120" as="geometry" />
        </mxCell>

        <!-- MongoDB KPI Metrics Database -->
        <mxCell id="db-kpi-mongo" value="&lt;b&gt;kpi_analytics_db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MongoDB 7.x&lt;br&gt;Collection: &lt;i&gt;daily_metrics&lt;/i&gt;&lt;br&gt;Fields: &lt;i&gt;windowStart, currency,&lt;br&gt;totalVolume, txnCount&lt;/i&gt;&lt;br&gt;Atomic $inc upserts&lt;/font&gt;" 
                style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#581c87;fontSize=11;verticalAlign=top;spacing=4;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1530" y="1030" width="180" height="115" as="geometry" />
        </mxCell>

        <!-- Redis Velocity Sliding Window Store -->
        <mxCell id="cache-kpi-redis" value="&lt;b&gt;Redis Velocity Window&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;code&gt;velocity:{accountId}&lt;/code&gt; (TTL: 5m)&lt;br&gt;Atomic Lua Script (&lt;code&gt;INCR&lt;/code&gt; + &lt;code&gt;EXPIRE&lt;/code&gt;)&lt;br&gt;&lt;code&gt;event:dedupe:{eventId}&lt;/code&gt; (TTL: 24h)&lt;br&gt;Sub-millisecond sliding check&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#991b1b;fontSize=10;verticalAlign=top;spacing=4;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1750" y="1035" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- RIGHT ZONE: ARCHITECTURAL PATTERN CALLOUTS & COMPLETE LEGEND           -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <!-- Legend Box -->
        <mxCell id="callout-legend" value="&lt;b&gt;DIAGRAM LEGEND &amp;amp; CONVENTIONS&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Component Color Palette:&lt;/b&gt;&lt;br&gt;🟩 &lt;b&gt;Primary Backend Services&lt;/b&gt; (Spring Boot 3.x, Clean Hexagonal)&lt;br&gt;🟦 &lt;b&gt;Clients &amp;amp; Frontend&lt;/b&gt; (Next.js 15 SPA, Browser)&lt;br&gt;🟨 &lt;b&gt;AI / Agentic Intelligence&lt;/b&gt; (Spring AI 1.0 GA, Specialist Agents)&lt;br&gt;🟪 &lt;b&gt;Persistent Data Stores&lt;/b&gt; (MongoDB 7.x, Qdrant Vector DB)&lt;br&gt;🟥 &lt;b&gt;In-Memory Cache &amp;amp; State&lt;/b&gt; (Redis Session, Lua Velocity, Locks)&lt;br&gt;🟧 &lt;b&gt;Event Streaming / Messaging&lt;/b&gt; (Apache Kafka, STOMP Broker)&lt;br&gt;⬜ &lt;b&gt;Edge &amp;amp; Security Gateway&lt;/b&gt; (Spring Cloud Gateway, Auth Server)&lt;br&gt;🔵 &lt;b&gt;External Cloud / Managed AI&lt;/b&gt; (Azure OpenAI GPT-4 API)&lt;br&gt;&lt;br&gt;&lt;b&gt;Connector Line Styles:&lt;/b&gt;&lt;br&gt;─── &lt;b&gt;Solid Line&lt;/b&gt;: Synchronous REST / gRPC Request-Response&lt;br&gt;- - - &lt;b&gt;Dashed Line (Gold)&lt;/b&gt;: Asynchronous Kafka Pub/Sub Event Stream&lt;br&gt;- - - &lt;b&gt;Dashed Line (Blue)&lt;/b&gt;: Bi-directional STOMP WebSocket Channel&lt;br&gt;······ &lt;b&gt;Dotted Line&lt;/b&gt;: Periodic Poller / Internal Heartbeat / Cache&lt;br&gt;&lt;br&gt;&lt;i&gt;All crossing lines feature arc bridges (&lt;code&gt;jumpStyle=arc&lt;/code&gt;) to avoid collisions.&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=2;fontSize=11;verticalAlign=top;spacing=8;shadow=1;align=left;" 
                vertex="1" parent="layer-annotations">
          <mxGeometry x="2040" y="85" width="440" height="310" as="geometry" />
        </mxCell>

        <!-- Callout 1: HITL 2-Step Pattern -->
        <mxCell id="callout-hitl" value="&lt;b&gt;PATTERN 1: 2-Step Human-in-the-Loop (HITL)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Problem:&lt;/b&gt; Prevent hallucinated or unintended financial transfers by LLM.&lt;br&gt;&lt;b&gt;Execution Flow:&lt;/b&gt;&lt;br&gt;1. User asks AI: &lt;i&gt;&quot;Send $500 to Bob for rent&quot;&lt;/i&gt;.&lt;br&gt;2. &lt;code&gt;TransactionSpecialistAgent&lt;/code&gt; invokes tool &lt;code&gt;StageTransfer&lt;/code&gt; via gRPC.&lt;br&gt;3. &lt;code&gt;Business-Operation-Service&lt;/code&gt; validates balance and creates a cryptographically signed &lt;code&gt;ConfirmationToken&lt;/code&gt;.&lt;br&gt;4. Token is stored in Redis (&lt;code&gt;confirm:token:{id}&lt;/code&gt;, TTL 5m).&lt;br&gt;5. AI pushes confirmation payload to &lt;code&gt;/user/{userId}/queue/confirmations&lt;/code&gt;.&lt;br&gt;6. User sees interactive modal in SPA. Clicking &lt;b&gt;[CONFIRM]&lt;/b&gt; sends the signed token to execute debit/credit.&lt;br&gt;&lt;i&gt;Zero unverified mutations ever occur from prompt alone!&lt;/i&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;verticalAlign=top;spacing=8;align=left;shadow=1;" 
                vertex="1" parent="layer-annotations">
          <mxGeometry x="2040" y="415" width="440" height="235" as="geometry" />
        </mxCell>

        <!-- Callout 2: Transactional Outbox Pattern -->
        <mxCell id="callout-outbox" value="&lt;b&gt;PATTERN 2: Transactional Outbox with Atomic Claim&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Problem:&lt;/b&gt; Avoid dual-write race conditions and lost Kafka events.&lt;br&gt;&lt;b&gt;Execution Flow:&lt;/b&gt;&lt;br&gt;1. Transfer executes within a single MongoDB transaction: records ledger transaction &amp;amp; writes outbox event (&lt;code&gt;status: PENDING&lt;/code&gt;).&lt;br&gt;2. &lt;code&gt;OutboxEventPublisher&lt;/code&gt; background poller atomically claims the next batch using MongoDB Criteria: &lt;code&gt;findAndModify(status: PENDING ➔ IN_FLIGHT)&lt;/code&gt;.&lt;br&gt;3. Event is published to Kafka topic &lt;code&gt;banking.transactions.v1&lt;/code&gt; with partition key &lt;code&gt;sourceAccountId&lt;/code&gt; (FIFO guarantee).&lt;br&gt;4. Upon broker ACK, status updates to &lt;code&gt;PUBLISHED&lt;/code&gt;.&lt;br&gt;5. MongoDB TTL index automatically purges records after 7 days.&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;verticalAlign=top;spacing=8;align=left;shadow=1;" 
                vertex="1" parent="layer-annotations">
          <mxGeometry x="2040" y="670" width="440" height="215" as="geometry" />
        </mxCell>

        <!-- Callout 3: Dual-Tier AI Memory & Semantic Cache -->
        <mxCell id="callout-memory" value="&lt;b&gt;PATTERN 3: Dual-Tier Memory &amp;amp; Semantic Cache&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Problem:&lt;/b&gt; Context window overflow, high LLM cost and latency.&lt;br&gt;&lt;b&gt;Multi-Tier Architecture:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Tier 0: Redis Semantic Cache&lt;/b&gt; (&lt;code&gt;semcache:*&lt;/code&gt;) — Intercepts repeated questions, returning cached completions in &amp;lt; 15ms.&lt;br&gt;• &lt;b&gt;Tier 1: Short-Term Working Memory&lt;/b&gt; (MongoDB Criteria Adapter) — Holds active conversation turns (last N messages) for exact continuity.&lt;br&gt;• &lt;b&gt;Tier 2: Long-Term Episodic Memory&lt;/b&gt; (Qdrant Vector DB) — Older chats are summarized, embedded (1536-dim), and retrieved via semantic similarity filtered by &lt;code&gt;userId&lt;/code&gt;.&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;verticalAlign=top;spacing=8;align=left;shadow=1;" 
                vertex="1" parent="layer-annotations">
          <mxGeometry x="2040" y="905" width="440" height="210" as="geometry" />
        </mxCell>

        <!-- Callout 4: OAuth2 Dual-Zone Zero-Trust Security -->
        <mxCell id="callout-security" value="&lt;b&gt;PATTERN 4: OAuth2 Dual-Zone Zero-Trust Security&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Public Edge:&lt;/b&gt; Browser holds only an opaque &lt;code&gt;APP_SESSION&lt;/code&gt; cookie with &lt;code&gt;HttpOnly; Secure; SameSite=Lax&lt;/code&gt;. Never sees or stores raw JWTs.&lt;br&gt;&lt;b&gt;Private Mesh:&lt;/b&gt; &lt;code&gt;Gateway-Service&lt;/code&gt; exchanges session for access token from Redis and forwards Bearer JWT via &lt;code&gt;TokenRelay&lt;/code&gt;. Downstream services are OAuth2 Resource Servers that validate JWT signature against &lt;code&gt;oauth2-authorization-server&lt;/code&gt; JWKS endpoint cached in memory.&lt;br&gt;&lt;b&gt;AKS NetworkPolicy:&lt;/b&gt; Downstream pods drop all traffic not from Gateway.&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;verticalAlign=top;spacing=8;align=left;shadow=1;" 
                vertex="1" parent="layer-annotations">
          <mxGeometry x="2040" y="1135" width="440" height="210" as="geometry" />
        </mxCell>


        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- ZERO-OVERLAP ARROWS & CONNECTOR ROUTING (STAGGERED PORTS + ARC JUMPS)   -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <!-- 1. Browser ➔ OAuth2 AS (Auth Code Flow / Redirect) -->
        <mxCell id="edge-browser-to-as" value="OAuth2 Auth Code Redirect" 
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;jumpStyle=arc;jumpSize=6;html=1;strokeColor=#64748b;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" 
                edge="1" source="client-browser-auth" target="svc-oauth2-as" parent="layer-edges">
