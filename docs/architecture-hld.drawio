        <mxCell id="kafka-topic-transactions" parent="layer-components" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#78350f;fontSize=11;verticalAlign=middle;spacing=6;shadow=1;" value="&lt;b&gt;Kafka: banking.transactions.v1&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Partition Key: &lt;code&gt;sourceAccountId&lt;/code&gt; (FIFO per account)&lt;br&gt;• Payload: &lt;i&gt;eventId, sourceUserId, targetUserId, amount, status&lt;/i&gt;&lt;br&gt;• Producers: &lt;b&gt;Business-Ops Outbox Poller&lt;/b&gt;&lt;br&gt;• Consumers: &lt;b&gt;KPI-Analytics&lt;/b&gt; &amp;amp; &lt;b&gt;Chat (Notifications)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Dead Letter Topic: banking.transactions.v1.DLT&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="340" x="1115" y="525" as="geometry" />
        </mxCell>
        <mxCell id="db-banking-mongo" parent="layer-components" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#581c87;fontSize=11;verticalAlign=top;spacing=4;shadow=1;" value="&lt;b&gt;banking_ops_db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MongoDB 7.x&lt;br&gt;Collections:&lt;br&gt;&lt;i&gt;accounts, transactions,&lt;br&gt;cards, outbox_events&lt;/i&gt;&lt;br&gt;TTL Index: 7d outbox purge&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="180" x="1530" y="525" as="geometry" />
        </mxCell>
        <mxCell id="cache-banking-redis" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#991b1b;fontSize=10;verticalAlign=top;spacing=4;shadow=1;" value="&lt;b&gt;Redis Idempotency &amp;amp; Cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;code&gt;idempotency:transfer:{key}&lt;/code&gt;&lt;br&gt;Atomic SETNX + 24h TTL&lt;br&gt;&lt;code&gt;account:balance:{accountId}&lt;/code&gt;&lt;br&gt;Write-Through Cache (TTL: 5m)&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="230" x="1750" y="525" as="geometry" />
        </mxCell>
        <mxCell id="client-ai-chat" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#78350f;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;Interactive AI Chat View&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Real-time token stream rendering&lt;br&gt;• Natural language financial queries&lt;br&gt;• &lt;b&gt;HITL Confirmation Modal&lt;/b&gt;:&lt;br&gt;  User explicitly clicks [CONFIRM]&lt;br&gt;  to authorize fund transfers&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="220" x="-75" y="735" as="geometry" />
        </mxCell>
        <mxCell id="gw-route-ai" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontSize=10;verticalAlign=top;spacing=4;" value="&lt;b&gt;Route: /api/v1/ai/**&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569;&quot;&gt;TokenRelay (Bearer JWT)&lt;br&gt;Proxies to AI Concierge :8085&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="220" x="375" y="740" as="geometry" />
        </mxCell>
        <mxCell id="svc-ai-concierge" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#78350f;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;Intelligence-Ai-Service (Spring AI 1.0 GA)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8085&lt;/b&gt; · Multi-Agent Agentic Financial Concierge&lt;br&gt;• &lt;b&gt;Advisor Pipeline&lt;/b&gt;: &lt;i&gt;SafeGuardAdvisor&lt;/i&gt; (OWASP LLM01) ➔ &lt;i&gt;MessageChatMemoryAdvisor&lt;/i&gt; ➔ &lt;i&gt;AiAuditAdvisor&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Multi-Agent Strategy&lt;/b&gt;: &lt;code&gt;IntentRouterAgent&lt;/code&gt; dispatches to:&lt;br&gt;  - &lt;i&gt;FinancialConciergeAgent&lt;/i&gt; (General FAQs, RAG search)&lt;br&gt;  - &lt;i&gt;TransactionSpecialistAgent&lt;/i&gt; (Balance check, stage transfer)&lt;br&gt;  - &lt;i&gt;CardSecuritySpecialistAgent&lt;/i&gt; (Lock/unlock cards)&lt;br&gt;  - &lt;i&gt;RiskEvaluatorAgent&lt;/i&gt; (Evaluator-Optimizer compliance check)&lt;br&gt;• &lt;b&gt;Least-Privilege @Tool Calling&lt;/b&gt; over gRPC Clients (:9093 / :9091)&lt;br&gt;• &lt;b&gt;HITL 2-Step Confirmation&lt;/b&gt;: Generates signed &lt;code&gt;ConfirmationToken&lt;/code&gt; in Redis&lt;br&gt;• Real-time token streaming to STOMP (&lt;code&gt;/user/{userId}/queue/ai-stream&lt;/code&gt;)&lt;br&gt;&lt;i&gt;2–4 Replicas · Namespace: banking-ai&lt;/i&gt;&lt;/font&gt;" vertex="1">
