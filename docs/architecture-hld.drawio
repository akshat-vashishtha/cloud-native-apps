        <mxCell id="svc-business-ops" parent="layer-components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#14532d;fontSize=11;verticalAlign=top;spacing=6;shadow=1;" value="&lt;b&gt;Business-Operation-Service (Banking Core)&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Port 8082 / gRPC 9093&lt;/b&gt; · JWT Resource Server&lt;br&gt;• Pure Domain Invariants: &lt;code&gt;Money&lt;/code&gt;, &lt;code&gt;Account&lt;/code&gt;, &lt;code&gt;Transfer&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Transactional Outbox&lt;/b&gt;: Atomic Criteria Claim (`PENDING` ➔ `IN_FLIGHT`)&lt;br&gt;• Optimistic Concurrency Control (@Version retry on balance)&lt;br&gt;• gRPC Server (&lt;code&gt;banking_service.proto&lt;/code&gt;) for AI tool executions&lt;br&gt;&lt;i&gt;3 Replicas · Namespace: banking-core&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="155" width="360" x="685" y="515" as="geometry" />
