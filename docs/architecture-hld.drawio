                style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#581c87;fontSize=11;verticalAlign=top;spacing=4;shadow=1;" 
                vertex="1" parent="layer-components">
          <mxGeometry x="1530" y="140" width="180" height="100" as="geometry" />
        </mxCell>

